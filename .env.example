# ─── PDFBlack Environment Variables (.env.local) ───
# Copia este archivo a .env.local y completa los valores.
# NUNCA subas .env.local a GitHub.

# =====================================================================
# SITIO WEB
# =====================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# FIREBASE (Fase 1: Auth + Analytics)
# Obtén estos valores en: Firebase Console > Configuración del proyecto > General > Aplicación web
# =====================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# =====================================================================
# FIREBASE ADMIN SDK (Fase 2-3: Functions, Firestore server-side)
# NO incluir en cliente. Solo para server-side / Cloud Functions.
# =====================================================================
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_ADMIN_PROJECT_ID=

# =====================================================================
# EMAIL (Resend API / Contacto corporativo — Fase 2)
# =====================================================================
CONTACT_EMAIL=contacto@pdf-black.com
RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=PDFBLACK
# SMTP_FROM_EMAIL=contacto@pdf-black.com

# =====================================================================
# MOTORES DE CONVERSIÓN EN LA NUBE & IA (Fase 3)
# =====================================================================
# Google Gemini 2.5 Flash / Pro (Reconstructor de Tablas y Cuadros)
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=

# CloudConvert API v2
CLOUDCONVERT_API_KEY=
NEXT_PUBLIC_CLOUDCONVERT_API_KEY=

# Adobe Acrobat Services API
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# =====================================================================
# ANALYTICS & TELEMETRÍA (opcional)
# =====================================================================
# NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID=
# Microsoft Clarity Project ID (obtenlo en https://clarity.microsoft.com/)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# =====================================================================
# GOOGLE SEARCH CONSOLE & SEO
# =====================================================================
# Código de verificación de Google Search Console (ej: google-site-verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# =====================================================================
# GOOGLE DRIVE OAUTH (Save to Drive)
# Configura en Google Cloud Console > APIs & Services > Credentials
# Scope: https://www.googleapis.com/auth/drive.file
# =====================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =====================================================================
# ENTORNO
# =====================================================================
NODE_ENV=development
ANALYZE=false