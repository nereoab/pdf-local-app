{
  "hosting": {
    "source": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.git/**",
      "**/.firebase/**",
      "**/.next/**",
      "**/node_modules/**",
      "**/graphify-out/**",
      "**/scratch/**",
      "**/*.traineddata",
      "**/*.pdf"
    ],
    "frameworksBackend": {
      "memory": "1GiB",
      "maxInstances": 10
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
