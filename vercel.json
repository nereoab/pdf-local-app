{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Access-Control-Allow-Origin", "value": "https://pdfblack.com" }
      ]
    },
    {
      "source": "/(.*\\.(js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico|webp|avif))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/inicio", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/edit", "destination": "/editar", "permanent": true },
    { "source": "/organize", "destination": "/organizar", "permanent": true },
    { "source": "/convert", "destination": "/convertir", "permanent": true },
    { "source": "/optimize", "destination": "/optimizar", "permanent": true },
    { "source": "/compress", "destination": "/optimizar/comprimir", "permanent": true },
    { "source": "/merge", "destination": "/organizar/unir", "permanent": true },
    { "source": "/split", "destination": "/organizar/dividir", "permanent": true },
    { "source": "/sign", "destination": "/editar/firma", "permanent": true },
    { "source": "/ocr", "destination": "/editar/ocr", "permanent": true },
    { "source": "/privacy", "destination": "/privacidad", "permanent": true },
    { "source": "/terms", "destination": "/terminos", "permanent": true },
    { "source": "/legal", "destination": "/aviso-legal", "permanent": true }
  ],
  "rewrites": [{ "source": "/api/health", "destination": "/api/health" }],
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "github": {
    "enabled": true,
    "autoAlias": true,
    "silent": false
  }
}
